[Unit]
Description=GarMyFriend face application
After=garmyfriend-lyra-zero-w-devices.service
Requires=garmyfriend-lyra-zero-w-devices.service
ConditionPathExists=/home/gar/GarMyFriend-LyraZeroW/scripts/run-face.cjs

[Service]
Type=simple
User=gar
WorkingDirectory=/home/gar/GarMyFriend-LyraZeroW
ExecStart=/usr/bin/node scripts/run-face.cjs
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=128M

[Install]
WantedBy=multi-user.target
