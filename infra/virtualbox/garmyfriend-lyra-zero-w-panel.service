[Unit]
Description=GarMyFriend display and rotary replacement panel
After=network-online.target garmyfriend-lyra-zero-w-devices.service
Requires=garmyfriend-lyra-zero-w-devices.service
Wants=network-online.target

[Service]
Type=simple
User=gar
WorkingDirectory=/home/gar/GarMyFriend-LyraZeroW
Environment=GAR_SIM_ENVIRONMENT=virtualbox-linux
EnvironmentFile=-/home/gar/.config/garmyfriend-lyra-zero-w/panel.env
ExecStart=/usr/bin/node simulation/server.cjs --port 8774
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=128M

[Install]
WantedBy=multi-user.target
